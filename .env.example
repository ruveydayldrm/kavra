# ─────────────────────────────────────────────────────────────────────────────
#  Kavra configuration. Copy to `.env` (never commit `.env`).
#  Everything here is optional except at least ONE working provider.
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider keys (both have free tiers, no credit card) ─────────────────────
# Gemini: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
# Groq:   https://console.groq.com     ->  API Keys -> Create API Key
GROQ_API_KEY=
# Ollama (local / offline mode): https://ollama.com, then `ollama pull qwen2.5:3b`
OLLAMA_URL=http://127.0.0.1:11434

# ── Role routing: "provider:model", fallbacks are tried in order ─────────────
# The generator writes questions; the auditor (a DIFFERENT model) reviews them.
GENERATOR=gemini:gemini-3.8-flash
GENERATOR_FALLBACKS=gemini:gemini-3.5-flash-lite,ollama:qwen2.5:3b
AUDITOR=groq:openai/gpt-oss-120b
AUDITOR_FALLBACKS=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite

# Privacy switch: true = every role runs on Ollama, nothing leaves your machine.
LOCAL_MODE=false
LOCAL_MODEL=qwen2.5:3b

# ── Free-tier budgets (per model). Check your own limits and lower if needed:
#    Gemini: https://aistudio.google.com/rate-limit
#    Groq:   https://console.groq.com/settings/limits
GEMINI_RPM=8
GEMINI_TPM=200000
GEMINI_RPD=200
GROQ_RPM=25
GROQ_TPM=7000
GROQ_RPD=900

# ── Pipeline quality knobs ───────────────────────────────────────────────────
QUESTIONS_PER_CHUNK=4        # questions requested per ~1600-char excerpt
CHUNK_CHARS=1600
DEDUP_THRESHOLD=0.88         # cosine similarity above which a question is a duplicate
QUOTE_MATCH_THRESHOLD=88     # fuzzy score (0-100) the source quote must reach in the excerpt
SINGLE_MODEL=false           # ablation only: skip the auditor stage

# ── Study ────────────────────────────────────────────────────────────────────
NEW_CARDS_PER_DAY=20
DESIRED_RETENTION=0.9

# ── Infra ────────────────────────────────────────────────────────────────────
# DATA_DIR=./data
EMBEDDER=minilm              # minilm (multilingual, ~120 MB) | hash (no download)
# Hugging Face cache. Use a path without non-ASCII characters on Windows.
HF_HOME=C:\dev\.hf
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
